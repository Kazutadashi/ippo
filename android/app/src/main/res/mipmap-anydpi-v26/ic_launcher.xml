<!-- Ippo's launcher icon on Android 8 and later: steps climbing toward
     the rising sun, in three ridges that fade into the distance. One
     step at a time, as the name says (一歩, "one step"). The sky and sun
     are the back layer and the steps the front one, so launchers that
     move the layers apart give it a little depth. The monochrome layer
     lets Android 13 and later tint it to match the phone's themed icons.
     Older Android uses the mipmap-*/ PNGs, rendered from the same drawing
     (docs/artwork/launcher-icon.svg). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

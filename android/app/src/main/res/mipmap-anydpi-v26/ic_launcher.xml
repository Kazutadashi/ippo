<!-- Ippo's launcher icon on Android 8 and later: the character 歩, "step",
     from 一歩, "one step", in see-through grey over a flat, poster-style
     mountain range at night. Drawn as vectors, so there are no image
     files. The monochrome layer (the character alone, solid) lets Android
     13 and later tint it to match the phone's themed icons. Older Android
     uses the mipmap-*/ PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

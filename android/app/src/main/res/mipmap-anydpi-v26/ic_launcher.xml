<!-- Ippo's launcher icon on Android 8 and later: a walking figure for
     一歩, "one step". Drawn as vectors, so there are no image files. The
     monochrome layer lets Android 13 and later tint it to match the
     phone's themed icons. Older Android uses the mipmap-*/ PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

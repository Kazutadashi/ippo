<!-- The back of Ippo's launcher icon: a dawn sky and the rising sun. The
     steps in front are ic_launcher_foreground.xml. Flat colours only.
     The source drawing is docs/artwork/launcher-icon.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The sky. -->
    <path
        android:fillColor="#FFFFC9A0"
        android:pathData="M0,0 H108 V108 H0 Z" />
    <!-- The sun, behind the farthest steps. -->
    <path
        android:fillColor="#FFFFF8EA"
        android:pathData="M50.5,45 A11.5,11.5 0 1,0 73.5,45 A11.5,11.5 0 1,0 50.5,45 Z" />
</vector>

<!-- The back of Ippo's launcher icon: a night sky with a few stars and a
     large moon, which the mountains in ic_launcher_foreground.xml partly
     hide. Drawn by hand for Ippo, inside the middle area every launcher
     shape shows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The sky, darkest at the top. It fills the whole icon. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#FF1B2A41" />
                <item android:offset="1" android:color="#FF324A5F" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- A few faint stars. -->
    <path
        android:fillColor="#8CF2EEE2"
        android:pathData="M25.55,28 a0.45,0.45 0 1,0 0.9,0 a0.45,0.45 0 1,0 -0.9,0 M33.65,22 a0.35,0.35 0 1,0 0.7,0 a0.35,0.35 0 1,0 -0.7,0 M83.6,26 a0.4,0.4 0 1,0 0.8,0 a0.4,0.4 0 1,0 -0.8,0 M45.7,30 a0.3,0.3 0 1,0 0.6,0 a0.3,0.3 0 1,0 -0.6,0 M27.7,40 a0.3,0.3 0 1,0 0.6,0 a0.3,0.3 0 1,0 -0.6,0" />
    <!-- A soft glow around the moon, in two rings. -->
    <path
        android:fillColor="#12E9E2CC"
        android:pathData="M38,50 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0" />
    <path
        android:fillColor="#1AE9E2CC"
        android:pathData="M42,50 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0" />
    <!-- The moon. -->
    <path
        android:fillColor="#FFE9E2CC"
        android:pathData="M45,50 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0" />
    <!-- A faint shade on one side, so it looks round. -->
    <path
        android:fillColor="#2EB9B29C"
        android:pathData="M51,54 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0" />
    <!-- Its craters: a few faint darker circles, for a little texture. -->
    <path
        android:fillColor="#298F8A78"
        android:pathData="M52.6,45 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
    <path
        android:fillColor="#218F8A78"
        android:pathData="M65.0,43 a2.0,2.0 0 1,0 4.0,0 a2.0,2.0 0 1,0 -4.0,0" />
    <path
        android:fillColor="#1F8F8A78"
        android:pathData="M63.8,53 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0" />
    <path
        android:fillColor="#248F8A78"
        android:pathData="M56.6,56 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" />
    <path
        android:fillColor="#1F8F8A78"
        android:pathData="M51.4,52 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
    <path
        android:fillColor="#1A8F8A78"
        android:pathData="M61.8,49 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0" />
    <path
        android:fillColor="#1A8F8A78"
        android:pathData="M69.5,49 a1.5,1.5 0 1,0 3.0,0 a1.5,1.5 0 1,0 -3.0,0" />
</vector>

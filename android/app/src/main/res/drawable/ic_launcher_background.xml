<!-- The back of Ippo's launcher icon: a small mountain range at night. A
     dark sky with a few stars, far peaks with snow on top, and two darker
     ridges in front. Drawn by hand for Ippo, inside the middle area every
     launcher shape shows. The character 歩 is in front, in
     ic_launcher_foreground.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The sky, darkest at the top. It fills the whole icon. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#FF0B1A2A" />
                <item android:offset="1" android:color="#FF1B3A4A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- A few faint stars. -->
    <path
        android:fillColor="#B3F2EEE2"
        android:pathData="M25.5,26 a0.5,0.5 0 1,0 1.0,0 a0.5,0.5 0 1,0 -1.0,0 M32.65,21 a0.35,0.35 0 1,0 0.7,0 a0.35,0.35 0 1,0 -0.7,0 M79.5,24 a0.5,0.5 0 1,0 1.0,0 a0.5,0.5 0 1,0 -1.0,0 M85.65,33 a0.35,0.35 0 1,0 0.7,0 a0.35,0.35 0 1,0 -0.7,0 M73.65,20 a0.35,0.35 0 1,0 0.7,0 a0.35,0.35 0 1,0 -0.7,0 M23.65,44 a0.35,0.35 0 1,0 0.7,0 a0.35,0.35 0 1,0 -0.7,0 M87.6,46 a0.4,0.4 0 1,0 0.8,0 a0.4,0.4 0 1,0 -0.8,0" />
    <!-- The mountains sit low, so the character has open sky above them. -->
    <group android:translateY="7">
        <!-- The far peaks. -->
        <path
            android:fillColor="#FF33566A"
            android:pathData="M14,78 L28,64 L36,70 L48,58 L58,68 L68,61 L80,72 L94,66 L94,108 L14,108 Z" />
        <!-- Snow on their tops. -->
        <path
            android:fillColor="#FFDCE6EA"
            android:pathData="M48,58 L52.2,62 L50,61.6 L48,63 L46,61.4 L44.3,61.6 Z M28,64 L31.2,67.2 L29.4,66.8 L28,68 L26.6,66.8 L25.2,67 Z M68,61 L71.6,64.1 L69.7,63.8 L68,65 L66.4,63.8 L64.6,64.1 Z" />
        <!-- A middle ridge, then the nearest one, darkest. -->
        <path
            android:fillColor="#FF22414F"
            android:pathData="M14,84 L30,74 L42,80 L56,72 L72,82 L84,76 L94,80 L94,108 L14,108 Z" />
        <path
            android:fillColor="#FF15303B"
            android:pathData="M14,90 L34,82 L50,88 L66,83 L94,89 L94,108 L14,108 Z" />
    </group>
</vector>

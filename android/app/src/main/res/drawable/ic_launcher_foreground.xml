<!-- The front of Ippo's launcher icon: three ridges of steps climbing to
     the right, one step at a time, in the Home header's mountain colours:
     snow white farthest, then stone, then fir green nearest. Every
     ridge has the same rhythm (two steps, 26 wide and 6 high), with the
     top corners of the steps a little rounded. The sky
     and moon are ic_launcher_background.xml. The source drawing is
     docs/artwork/launcher-icon.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The farthest steps, snow white. -->
    <path
        android:fillColor="#FFB4C0CF"
        android:pathData="M0,108 V58 H40 V53.8 Q40,52 41.8,52 H66 V47.8 Q66,46 67.8,46 H108 V108 Z" />
    <!-- The middle steps, stone. -->
    <path
        android:fillColor="#FF5F6D86"
        android:pathData="M0,108 V68 H30 V63.8 Q30,62 31.8,62 H56 V57.8 Q56,56 57.8,56 H108 V108 Z" />
    <!-- The nearest steps, fir green. -->
    <path
        android:fillColor="#FF101922"
        android:pathData="M0,108 V78 H22 V73.8 Q22,72 23.8,72 H48 V67.8 Q48,66 49.8,66 H108 V108 Z" />
</vector>

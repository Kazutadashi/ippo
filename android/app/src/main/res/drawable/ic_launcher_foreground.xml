<!-- The front of Ippo's launcher icon: a trail of steps climbing to a flag
     on the summit. Ippo (一歩) means "one step": progress made step by
     step. Drawn by hand for Ippo; the mountain is in
     ic_launcher_background.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The scene is drawn on a 108-unit grid and shrunk to 74 % around the
         centre, so it fits the middle area every launcher shape shows. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.74"
        android:scaleY="0.74">
        <!-- The trail, as short dashes (vector drawables have no dashed
             lines), from the foot of the mountain up to the summit. -->
        <path
            android:strokeColor="#FFE9C46A"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M56.00,106.00 L53.54,103.95 M51.24,102.03 L48.78,99.98 M46.47,98.06 L44.02,96.01 M46.53,94.42 L49.24,92.72 M51.78,91.13 L54.50,89.44 M57.04,87.85 L59.76,86.15 M57.92,84.26 L55.46,82.22 M53.15,80.29 L50.70,78.25 M48.39,76.33 L48.00,76.00 M48.00,76.00 L49.90,74.10 M52.02,71.98 L54.29,69.71 M56.41,67.59 L58.00,66.00 M58.00,66.00 L57.84,65.06 M57.35,62.10 L56.82,58.95 M56.33,55.99 L55.81,52.83 M55.31,49.87 L54.79,46.72 M54.29,43.76 L54.00,42.00" />
        <!-- The flag on the summit: its pole, then the flag. -->
        <path
            android:fillColor="#FFF2EEE2"
            android:pathData="M53.3,21 L54.7,21 L54.7,34 L53.3,34 Z" />
        <path
            android:fillColor="#FFE9C46A"
            android:pathData="M54.7,21 L64,24.2 L54.7,27.4 Z" />
    </group>
</vector>

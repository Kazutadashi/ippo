<!-- The front of Ippo's launcher icon: a mountain range drawn flat, like a
     modern travel poster, each peak split into a lit face and a shaded
     one. The moon behind it is in ic_launcher_background.xml. Drawn by
     hand for Ippo, inside the middle area every launcher shape shows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The tall peak on the left: its lit face, then its shaded face. -->
    <path
        android:fillColor="#FF5C7C8A"
        android:pathData="M10,92 L40,46 L40,92 Z" />
    <path
        android:fillColor="#FF3F5F6E"
        android:pathData="M40,46 L72,92 L40,92 Z" />
    <!-- The peak on the right, in front of it. -->
    <path
        android:fillColor="#FF7B97A0"
        android:pathData="M40,92 L68,56 L68,92 Z" />
    <path
        android:fillColor="#FF557480"
        android:pathData="M68,56 L98,92 L68,92 Z" />
    <!-- Two low hills in the front. -->
    <path
        android:fillColor="#FF2C4653"
        android:pathData="M10,92 L26,70 L42,92 Z" />
    <path
        android:fillColor="#FF22394A"
        android:pathData="M52,92 L80,74 L100,92 Z" />
    <!-- The ground below the peaks. -->
    <path
        android:fillColor="#FF22394A"
        android:pathData="M0,92 L108,92 L108,108 L0,108 Z" />
</vector>

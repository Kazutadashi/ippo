<!-- Ippo's launcher icon in one colour, for the themed icons of Android 13
     and later: the system tints it. The sun and each ridge of steps are
     drawn side by side, not over each other, and the ridges grow fainter
     with the distance, so the layers still show in a single colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The sun: only the part in the sky, above the farthest steps. -->
    <group>
        <clip-path
            android:pathData="M0,0 H108 V46 H67.8 Q66,46 66,47.8 V52 H41.8 Q40,52 40,53.8 V58 H0 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M50.5,45 A11.5,11.5 0 1,0 73.5,45 A11.5,11.5 0 1,0 50.5,45 Z" />
    </group>
    <!-- The farthest steps, down to the middle ones. -->
    <path
        android:fillColor="#FF000000"
        android:fillAlpha="0.4"
        android:pathData="M0,58 H40 V53.8 Q40,52 41.8,52 H66 V47.8 Q66,46 67.8,46 H108 V56 H57.8 Q56,56 56,57.8 V62 H31.8 Q30,62 30,63.8 V68 H0 Z" />
    <!-- The middle steps, down to the nearest ones. -->
    <path
        android:fillColor="#FF000000"
        android:fillAlpha="0.7"
        android:pathData="M0,68 H30 V63.8 Q30,62 31.8,62 H56 V57.8 Q56,56 57.8,56 H108 V66 H49.8 Q48,66 48,67.8 V72 H23.8 Q22,72 22,73.8 V78 H0 Z" />
    <!-- The nearest steps. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M0,108 V78 H22 V73.8 Q22,72 23.8,72 H48 V67.8 Q48,66 49.8,66 H108 V108 Z" />
</vector>

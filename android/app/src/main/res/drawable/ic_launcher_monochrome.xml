<!-- Ippo's launcher icon in one colour, for the themed icons of Android 13
     and later: the system tints it. The sun and each ridge of steps are
     drawn side by side, not over each other, and the ridges grow fainter
     with the distance, so the layers still show in a single colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The sun: the part above the farthest steps. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M54.5,49 A9.5,9.5 0 0,1 73.5,49 Z M54.5,49 L55.4,53 L58,53 L58,49 Z" />
    <!-- The farthest steps, down to the middle ones. -->
    <path
        android:fillColor="#FF000000"
        android:fillAlpha="0.4"
        android:pathData="M0,58 H36 V53 H58 V49 H108 V58 H52 V63 H28 V68 H0 Z" />
    <!-- The middle steps, down to the nearest ones. -->
    <path
        android:fillColor="#FF000000"
        android:fillAlpha="0.7"
        android:pathData="M0,68 H28 V63 H52 V58 H108 V64 H70 V69 H44 V74 H22 V79 H0 Z" />
    <!-- The nearest steps. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M0,79 H22 V74 H44 V69 H70 V64 H108 V108 H0 Z" />
</vector>

<!-- Ippo's icon in one colour, for Android's themed icons (Android 13 and
     later tint it to match the phone): the mountain with its flag. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The scene is drawn on a 108-unit grid and shrunk to 74 % around the
         centre, so it fits the middle area every launcher shape shows. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.74"
        android:scaleY="0.74">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M-10,112 L54,34 L118,112 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M53.3,21 L54.7,21 L54.7,34 L53.3,34 Z M54.7,21 L64,24.2 L54.7,27.4 Z" />
    </group>
</vector>
